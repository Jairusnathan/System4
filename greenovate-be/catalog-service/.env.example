# Catalog service
# Copy to .env and fill in your values.

CATALOG_SERVICE_PORT=4102

# POS / Inventory Supabase - products, storebranches, branch_inventory, receipts, transactions
SECOND_SUPABASE_URL=https://your-pos-project-id.supabase.co
SECOND_SUPABASE_ANON_KEY=your-pos-anon-key-here
SECOND_SUPABASE_SERVICE_ROLE_KEY=your-pos-service-role-key-here

# Note: No auth DB needed — catalog-service only accesses the POS/inventory database
