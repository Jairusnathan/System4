# Analytics service
# NOTE: Analytics features (trending searches, search tracking) have been merged into auth-service.
# This service is no longer started — it is kept for reference only.
# See auth-service/.env.example for the active configuration.

ANALYTICS_SERVICE_PORT=4107
NODE_ENV=development

# APICenter SDK - use your issued shared or service-specific tribe credentials
APICENTER_URL=https://api-center-test.itsandbox.site
APICENTER_TRIBE_ID=greenovate
APICENTER_TRIBE_SECRET=replace-with-issued-tribe-secret
