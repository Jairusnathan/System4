# Root-level safety net — catches anything the sub-project gitignores miss

# Never commit real env files
.env
.env.local
.env.*
!.env.example
!**/.env.example

# Dependencies
node_modules/

# Build output
dist/
build/
.next/

# OS junk
.DS_Store
Thumbs.db

# IDE
.vscode/*
!.vscode/settings.json
.idea/
