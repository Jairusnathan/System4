# Auth service
# Copy to .env and fill in your values.

AUTH_SERVICE_PORT=4101
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000

# Primary Supabase - customers, browsing_history, search_analytics tables
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT - must match order-service and cart-service
JWT_SECRET=replace-with-a-long-random-secret

# SMTP (required for verification, password reset, and order emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-here
SMTP_FROM=PharmaQuick <your-email@gmail.com>
