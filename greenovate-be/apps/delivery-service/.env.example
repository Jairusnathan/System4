DELIVERY_SERVICE_PORT=4106
PORT=4106
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Primary Supabase
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Catalog / POS Supabase
SECOND_SUPABASE_URL=https://your-catalog-project-id.supabase.co
SECOND_SUPABASE_ANON_KEY=your-catalog-anon-key-here
SECOND_SUPABASE_SERVICE_ROLE_KEY=your-catalog-service-role-key-here

# Optional: override the public Nominatim endpoint and identify your app.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=PharmaQuickDelivery/1.0 (contact: local-dev)
