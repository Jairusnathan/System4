# ── Cart Service ──────────────────────────────────────────────────────────────
# Copy to .env and fill in your values.

CART_SERVICE_PORT=4103
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000

# Cart Supabase — cart_items table
# Get from: Supabase dashboard → Project Settings → API
SUPABASE_URL=https://your-cart-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_SUPABASE_URL=https://your-cart-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT — must match auth-service and api-gateway
JWT_SECRET=replace-with-a-long-random-secret

# Catalog service URL (for stock lookups)
CATALOG_SERVICE_URL=http://127.0.0.1:4102
