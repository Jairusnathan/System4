# Order service
# Copy to .env and fill in your values.

ORDER_SERVICE_PORT=4105

# Order Supabase - online orders only
SUPABASE_URL=https://your-order-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT - must match auth-service and cart-service
JWT_SECRET=replace-with-a-long-random-secret

# Receipt/transaction status is fetched via catalog-service API (no direct POS DB access needed)
