# ── API Gateway ───────────────────────────────────────────────────────────────
# Copy to .env and fill in your values.

OOS_GATEWAY_PORT=3001

# APICenter SDK - use your issued shared or service-specific tribe credentials
OOS_GATEWAY_APICENTER_URL=https://api-center-test.itsandbox.site
OOS_GATEWAY_APICENTER_TRIBE_ID=greenovate
OOS_GATEWAY_APICENTER_TRIBE_SECRET=replace-with-issued-tribe-secret

# Downstream service URLs (defaults shown — change if running on different ports/hosts)
OOS_GATEWAY_AUTH_SERVICE_URL=http://127.0.0.1:3002
OOS_GATEWAY_CATALOG_SERVICE_URL=http://127.0.0.1:3005
OOS_GATEWAY_CART_SERVICE_URL=http://127.0.0.1:3004
OOS_GATEWAY_ORDER_SERVICE_URL=http://127.0.0.1:3003
OOS_GATEWAY_DELIVERY_SERVICE_URL=http://127.0.0.1:3007

# CORS — comma-separated list of allowed frontend origins
OOS_GATEWAY_ALLOWED_ORIGINS=http://localhost:3000
