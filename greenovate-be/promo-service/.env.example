# Promo service
# Copy to .env and fill in your values.

OOS_PROMO_PORT=3006

# APICenter SDK - use your issued shared or service-specific tribe credentials
OOS_PROMO_APICENTER_URL=https://api-center-test.itsandbox.site
OOS_PROMO_APICENTER_TRIBE_ID=greenovate
OOS_PROMO_APICENTER_TRIBE_SECRET=replace-with-issued-tribe-secret

# Catalog / POS Supabase - promo_codes table
OOS_PROMO_SECOND_SUPABASE_URL=https://your-catalog-project-id.supabase.co
OOS_PROMO_SECOND_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
