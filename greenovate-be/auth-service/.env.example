# Auth service
# Copy to .env and fill in your values.

OOS_AUTH_PORT=3002
NODE_ENV=development
OOS_AUTH_ALLOWED_ORIGINS=http://localhost:3000

# Primary Supabase - customers, browsing_history, search_analytics tables
OOS_AUTH_SUPABASE_URL=https://your-project-id.supabase.co
OOS_AUTH_SUPABASE_ANON_KEY=your-anon-key-here
OOS_AUTH_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT - must match order-service and cart-service
OOS_AUTH_JWT_SECRET=replace-with-a-long-random-secret

# APICenter SDK - use your issued shared or service-specific tribe credentials
OOS_AUTH_APICENTER_URL=https://api-center-test.itsandbox.site
OOS_AUTH_APICENTER_TRIBE_ID=greenovate
OOS_AUTH_APICENTER_TRIBE_SECRET=replace-with-issued-tribe-secret

# SMTP (required for verification, password reset, and order emails)
OOS_AUTH_SMTP_HOST=smtp.gmail.com
OOS_AUTH_SMTP_PORT=465
OOS_AUTH_SMTP_USER=your-email@gmail.com
OOS_AUTH_SMTP_PASS=your-app-password-here
OOS_AUTH_SMTP_FROM=PharmaQuick <your-email@gmail.com>
