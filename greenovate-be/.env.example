# ── Monolith / shared backend ─────────────────────────────────────────────────
# Copy this file to .env and fill in your values. Never commit .env.

NODE_ENV=development
PORT=4000
ALLOWED_ORIGINS=http://localhost:3000
ENABLE_SWAGGER=true

# ── Primary Supabase — auth + branches + customers ────────────────────────────
# Get from: Supabase dashboard → Project Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Cart Supabase — cart_items table ──────────────────────────────────────────
CART_SUPABASE_URL=https://your-cart-project-id.supabase.co
CART_SUPABASE_SECRET_KEY=your-cart-service-role-key-here

# ── Order Supabase — transactions, receipts, orders ───────────────────────────
ORDER_SUPABASE_URL=https://your-order-project-id.supabase.co
ORDER_SUPABASE_SECRET_KEY=your-order-service-role-key-here

# ── Catalog / POS Supabase — products, stock ──────────────────────────────────
SECOND_SUPABASE_URL=https://your-catalog-project-id.supabase.co
SECOND_SUPABASE_ANON_KEY=your-catalog-anon-key-here
SECOND_SUPABASE_SERVICE_ROLE_KEY=your-catalog-service-role-key-here

# ── JWT ───────────────────────────────────────────────────────────────────────
# Must be the same value across auth-service, cart-service, and api-gateway.
# Use a long random string: openssl rand -hex 64
JWT_SECRET=replace-with-a-long-random-secret

# ── SMTP (optional) ───────────────────────────────────────────────────────────
# Only required for password reset and welcome emails.
# Leave blank to disable email features.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-here
SMTP_FROM=YourApp <your-email@gmail.com>
