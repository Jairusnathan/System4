# Cart service
# Copy to .env and fill in your values.

CART_SERVICE_PORT=4103
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000

# Cart Supabase - cart_items table
SUPABASE_URL=https://your-cart-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Catalog / POS Supabase - product lookups
SECOND_SUPABASE_URL=https://your-catalog-project-id.supabase.co
SECOND_SUPABASE_ANON_KEY=your-catalog-anon-key-here
SECOND_SUPABASE_SERVICE_ROLE_KEY=your-catalog-service-role-key-here

# JWT - must match auth-service
JWT_SECRET=replace-with-a-long-random-secret
