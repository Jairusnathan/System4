# Catalog service
# Copy to .env and fill in your values.

OOS_CATALOG_PORT=3005

# APICenter SDK - use your issued shared or service-specific tribe credentials
OOS_CATALOG_APICENTER_URL=https://api-center-test.itsandbox.site
OOS_CATALOG_APICENTER_TRIBE_ID=greenovate
OOS_CATALOG_APICENTER_TRIBE_SECRET=replace-with-issued-tribe-secret

# POS / Inventory Supabase - products, storebranches, branch_inventory, receipts, transactions
OOS_CATALOG_SECOND_SUPABASE_URL=https://your-pos-project-id.supabase.co
OOS_CATALOG_SECOND_SUPABASE_ANON_KEY=your-pos-anon-key-here
OOS_CATALOG_SECOND_SUPABASE_SERVICE_ROLE_KEY=your-pos-service-role-key-here

# Note: No auth DB needed — catalog-service only accesses the POS/inventory database
