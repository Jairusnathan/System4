# Delivery service
# Copy to .env and fill in your values.

OOS_DELIVERY_PORT=3007
NODE_ENV=development
OOS_DELIVERY_ALLOWED_ORIGINS=http://localhost:3000

# APICenter SDK - use your issued shared or service-specific tribe credentials
OOS_DELIVERY_APICENTER_URL=https://api-center-test.itsandbox.site
OOS_DELIVERY_APICENTER_TRIBE_ID=greenovate
OOS_DELIVERY_APICENTER_TRIBE_SECRET=replace-with-issued-tribe-secret

# Primary Supabase - delivery_rates table
OOS_DELIVERY_SUPABASE_URL=https://your-project-id.supabase.co
OOS_DELIVERY_SUPABASE_ANON_KEY=your-anon-key-here
