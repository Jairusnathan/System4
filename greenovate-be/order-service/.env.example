# Order service
# Copy to .env and fill in your values.

ORDER_SERVICE_PORT=4105

# Order Supabase - online_orders, online_order_items, transactions, receipts
SUPABASE_URL=https://your-order-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT - must match auth-service and cart-service
JWT_SECRET=replace-with-a-long-random-secret

# APICenter SDK - use your issued shared or service-specific tribe credentials
APICENTER_URL=https://api-center-test.itsandbox.site
APICENTER_TRIBE_ID=greenovate
APICENTER_TRIBE_SECRET=replace-with-issued-tribe-secret

# Frontend base URL - used to build PayMongo success/cancel redirect URLs
APP_BASE_URL=https://your-app-domain.com

# SMTP - order confirmation and cancellation emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-here
SMTP_FROM=PharmaQuick <your-email@gmail.com>

# Note: No POS/inventory DB needed — receipt/transaction status is fetched via catalog-service API
