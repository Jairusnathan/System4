# Cart service
# Copy to .env and fill in your values.

CART_SERVICE_PORT=4103
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000

# Cart Supabase - cart_items table (only database cart-service needs)
SUPABASE_URL=https://your-cart-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT - must match auth-service and order-service
JWT_SECRET=replace-with-a-long-random-secret

# Note: No POS DB needed — product lookups go through catalog-service API
