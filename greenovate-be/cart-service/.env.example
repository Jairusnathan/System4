# Cart service
# Copy to .env and fill in your values.

OOS_CART_PORT=3004
NODE_ENV=development
OOS_CART_ALLOWED_ORIGINS=http://localhost:3000

# Cart Supabase - cart_items table (only database cart-service needs)
OOS_CART_SUPABASE_URL=https://your-cart-project-id.supabase.co
OOS_CART_SUPABASE_ANON_KEY=your-anon-key-here
OOS_CART_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT - must match auth-service and order-service
OOS_CART_JWT_SECRET=replace-with-a-long-random-secret

# APICenter SDK - use your issued shared or service-specific tribe credentials
OOS_CART_APICENTER_URL=https://api-center-test.itsandbox.site
OOS_CART_APICENTER_TRIBE_ID=greenovate
OOS_CART_APICENTER_TRIBE_SECRET=replace-with-issued-tribe-secret

# Note: No POS DB needed — product lookups go through catalog-service API
