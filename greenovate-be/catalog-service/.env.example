# Catalog service
# Copy to .env and fill in your values.

CATALOG_SERVICE_PORT=4102

# Primary Supabase - branch metadata
SUPABASE_URL=https://your-primary-project-id.supabase.co
SUPABASE_ANON_KEY=your-primary-anon-key-here

# Catalog / POS Supabase - products and stock
SECOND_SUPABASE_URL=https://your-catalog-project-id.supabase.co
SECOND_SUPABASE_ANON_KEY=your-catalog-anon-key-here
SECOND_SUPABASE_SERVICE_ROLE_KEY=your-catalog-service-role-key-here
