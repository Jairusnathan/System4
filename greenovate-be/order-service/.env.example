# Order service
# Copy to .env and fill in your values.

ORDER_SERVICE_PORT=4105

# Order Supabase - online orders
SUPABASE_URL=https://your-order-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# POS / catalog Supabase - receipts and transactions
SECOND_SUPABASE_URL=https://your-catalog-project-id.supabase.co
SECOND_SUPABASE_SERVICE_ROLE_KEY=your-catalog-service-role-key-here

# JWT - must match auth-service and cart-service
JWT_SECRET=replace-with-a-long-random-secret
