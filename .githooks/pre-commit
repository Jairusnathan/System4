#!/bin/sh
# Pre-commit hook: blocks .env files (not .env.example) from being committed.
# Install once: git config core.hooksPath .githooks

STAGED=$(git diff --cached --name-only)

BLOCKED=""
for file in $STAGED; do
  # Match any .env file that is NOT an .env.example
  case "$file" in
    *.env.example) ;;           # allowed
    */.env.example) ;;          # allowed
    .env.example) ;;            # allowed
    *.env | */.env | \
    *.env.* | */.env.*)
      BLOCKED="$BLOCKED\n  $file"
      ;;
  esac
done

if [ -n "$BLOCKED" ]; then
  echo ""
  echo "🚫  COMMIT BLOCKED — credential files detected:"
  printf "$BLOCKED"
  echo ""
  echo ""
  echo "These files contain real credentials and must never be committed."
  echo "Add them to .gitignore if they are not already there."
  echo ""
  exit 1
fi

exit 0
