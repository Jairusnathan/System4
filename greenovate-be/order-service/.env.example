# Order service
# Copy to .env and fill in your values.

OOS_ORDER_PORT=3003

# Order Supabase - online_orders, online_order_items, transactions, receipts
OOS_ORDER_SUPABASE_URL=https://your-order-project-id.supabase.co
OOS_ORDER_SUPABASE_ANON_KEY=your-anon-key-here
OOS_ORDER_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT - must match auth-service and cart-service
OOS_ORDER_JWT_SECRET=replace-with-a-long-random-secret

# APICenter SDK - use your issued shared or service-specific tribe credentials
OOS_ORDER_APICENTER_URL=https://api-center-test.itsandbox.site
OOS_ORDER_APICENTER_TRIBE_ID=greenovate
OOS_ORDER_APICENTER_TRIBE_SECRET=replace-with-issued-tribe-secret

# Frontend base URL - used to build PayMongo success/cancel redirect URLs
OOS_ORDER_APP_BASE_URL=https://your-app-domain.com

# SMTP - order confirmation and cancellation emails
OOS_ORDER_SMTP_HOST=smtp.gmail.com
OOS_ORDER_SMTP_PORT=465
OOS_ORDER_SMTP_USER=your-email@gmail.com
OOS_ORDER_SMTP_PASS=your-app-password-here
OOS_ORDER_SMTP_FROM=PharmaQuick <your-email@gmail.com>

# Note: No POS/inventory DB needed — receipt/transaction status is fetched via catalog-service API
