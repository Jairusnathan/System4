# ── API Gateway ───────────────────────────────────────────────────────────────
# Copy to .env and fill in your values.

API_GATEWAY_PORT=4000
 
# APICenter SDK - use your issued shared or service-specific tribe credentials
APICENTER_URL=https://api-center-test.itsandbox.site
APICENTER_TRIBE_ID=greenovate
APICENTER_TRIBE_SECRET=replace-with-issued-tribe-secret

# Downstream service URLs (defaults shown — change if running on different ports/hosts)
AUTH_SERVICE_URL=http://127.0.0.1:4101
CATALOG_SERVICE_URL=http://127.0.0.1:4102
CART_SERVICE_URL=http://127.0.0.1:4103
ORDER_SERVICE_URL=http://127.0.0.1:4105
DELIVERY_SERVICE_URL=http://127.0.0.1:4106

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000
